# Copy to .env. Never commit .env.
ANTHROPIC_API_KEY=

# Optional: `kaggle auth login` or ~/.kaggle/access_token also work.
KAGGLE_API_TOKEN=

# Model used by the specialist agents and model used by the verifier's semantic check.
SLAYER_AGENT_MODEL=claude-opus-5-5
SLAYER_CHECK_MODEL=claude-haiku-5-5
